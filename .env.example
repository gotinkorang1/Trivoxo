# ─────────────────────────────────────────────────────────────
# Trivoxo V2 — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Core --------------------------------------------------------
# Postgres connection string. Local Docker: see docker-compose.yml (host port
# 5433 to avoid clashing with any native Postgres on 5432).
# Supabase (prod/staging): use the connection pooler URI.
DATABASE_URI=postgres://trivoxo:trivoxo@127.0.0.1:5433/trivoxo
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public base URL of the site (used for absolute links, SEO, webhooks).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media — Cloudinary (§8) ------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payments — Paystack Ghana (§45) ----------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Transactional email — Resend (§49) -------------------------
# RESEND_API_KEY=
# EMAIL_FROM="Trivoxo <hello@trivoxogh.com>"

# Maps (§29) --------------------------------------------------
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Bot protection — Cloudflare Turnstile (§88) ----------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Analytics / monitoring (§89) -------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_GA_ID=
# SENTRY_DSN=
