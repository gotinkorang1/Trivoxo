# ─────────────────────────────────────────────────────────────
# Trivoxo V2 — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Core --------------------------------------------------------
# Postgres connection string. Local Docker: see docker-compose.yml (host port
# 5433 to avoid clashing with any native Postgres on 5432).
# Supabase (prod/staging): use the connection pooler URI.
DATABASE_URI=postgres://trivoxo:trivoxo@127.0.0.1:5433/trivoxo
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public base URL of the site (used for absolute links, SEO, webhooks).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Authenticates the scheduled stale-hold reconciliation endpoint. Use 16+ random characters.
CRON_SECRET=

# Media — Cloudinary (§8) ------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Use separate folders per environment, e.g. trivoxo/production and trivoxo/preview.
CLOUDINARY_FOLDER=trivoxo/development

# Payments — Paystack Ghana (§45) ----------------------------
# Keep `test` in development/staging and change to `live` only with live keys.
PAYSTACK_MODE=test
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Transactional email — Resend (§49) -------------------------
# RESEND_API_KEY=
# EMAIL_FROM="Trivoxo <hello@trivoxogh.com>"
# EMAIL_REPLY_TO=info@trivoxoghana.com

# Maps (§29) --------------------------------------------------
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Bot protection — Cloudflare Turnstile (§88) ----------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Distributed rate limiting - Upstash Redis (section 88)
# Vercel Marketplace injects these automatically into connected environments.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional dedicated salt; PAYLOAD_SECRET is used when this is omitted.
# RATE_LIMIT_SALT=

# Two-factor authentication (admin) ---------------------------
# When 'true', every staff login must pass an authenticator-app (TOTP) code,
# and un-enrolled users are forced to set it up before using the admin. Leave
# unset/false to roll out: staff enrol from Admin → Security, then flip BOTH
# flags to 'true' together (server + client). Secrets are encrypted with
# PAYLOAD_SECRET. Set both to the same value.
# TWO_FACTOR_ENFORCED=false
# NEXT_PUBLIC_TWO_FACTOR_ENFORCED=false

# Product analytics - PostHog (section 89) --------------------
# Analytics starts only after the visitor grants consent. Vercel Marketplace
# can supply the project token/host; use the EU host for the EU data region.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Web analytics - Google Analytics 4 (section 89) --------------
# Create a GA4 web data stream and use its G-... measurement ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error and performance monitoring - Sentry (section 88) -------
# Vercel Marketplace injects these into Production and Preview. Keep the auth
# token server/build-only; never add NEXT_PUBLIC_ to it.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional integration-managed observability values:
# SENTRY_PUBLIC_KEY=
# SENTRY_OTLP_TRACES_URL=
# SENTRY_VERCEL_LOG_DRAIN_URL=
